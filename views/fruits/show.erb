<h2>Mer information om <%=@fruit["name"] %></h2>
<p>"<%=@fruit["description"] %>"</p>


<%
full_stars = @fruit["tastiness"]/2
half_stars = @fruit["tastiness"] % 2
%>

<p class="rating">
<% 5.times do |i| %>
    <% if i < full_stars %>
        ★
    <% elsif i < full_stars + half_stars %>
        ⯪
    <% else %>
        ☆
    <% end %>
<% end %>
</p>
